{
  "manifest_version": 3,
  "name": "OGFonts Inspector",
  "version": "1.2.0",
  "description": "Audit every font on a page, inspect type with contrast and OpenType, then copy CSS, tokens, or Tailwind.",
  "action": {
    "default_title": "Toggle OGFonts Inspector (Alt+Shift+F)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle OGFonts Inspector"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["panel.css", "fonts/*"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ]
}
